# Copier vers .env et remplacer chaque valeur. Ne jamais publier .env dans Git.
# DNS A/AAAA doit pointer sur votre VPS; ouvrir 80/tcp et 443/tcp (+443/udp si HTTP/3).
DOMAIN=campus.example.org
# Secret long: python3 -c "import secrets; print(secrets.token_hex(48))"
AUTH_SECRET=REPLACE_WITH_96_HEX_CHARACTERS
# Utiliser un mot de passe hexadecimal (pas de ponctuation, pour eviter l'encodage URL).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
# Adresse administrateur : doit utiliser un domaine etudiant autorise.
ADMIN_EMAILS=moderation@epita.fr
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=REPLACE_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
SMTP_FROM=Campus Connect <noreply@example.org>
